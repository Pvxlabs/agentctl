{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentctl.dev/schemas/trusted-identity-v1.schema.json",
  "title": "Trusted Development Access identity assertion v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "iss", "sub", "principal_type", "scopes", "aud", "environment", "transport", "iat", "nbf", "exp", "jti", "kid", "principal_epoch", "key_epoch"],
  "properties": {
    "version": {"const": "trusted-dev-identity/v1"},
    "iss": {"type": "string", "minLength": 1},
    "sub": {"type": "string", "minLength": 1},
    "principal_type": {"enum": ["human", "agent", "observer"]},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "aud": {"type": "string", "minLength": 1},
    "environment": {"enum": ["dev", "development"]},
    "transport": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
    "iat": {"type": "integer", "minimum": 0},
    "nbf": {"type": "integer", "minimum": 0},
    "exp": {"type": "integer", "minimum": 1},
    "jti": {"type": "string", "minLength": 1},
    "kid": {"type": "string", "minLength": 1},
    "principal_epoch": {"type": "integer", "minimum": 0},
    "key_epoch": {"type": "integer", "minimum": 0},
    "peer_identity": {"type": "string", "minLength": 1}
  }
}
