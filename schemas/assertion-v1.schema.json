{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentctl.dev/schemas/assertion-v1.schema.json",
  "title": "Agent Action Assertion v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "iss", "sub", "aud", "environment", "scope", "iat", "nbf",
    "exp", "jti", "kid", "http_method", "canonical_path", "content_type",
    "body_sha256", "request_id", "principal_epoch", "key_epoch"
  ],
  "properties": {
    "version": {"const": "agent-action-assertion/v1"},
    "iss": {"type": "string", "minLength": 1},
    "sub": {"type": "string", "minLength": 1},
    "aud": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "iat": {"type": "integer", "minimum": 0},
    "nbf": {"type": "integer", "minimum": 0},
    "exp": {"type": "integer", "minimum": 1},
    "jti": {"type": "string", "minLength": 1},
    "kid": {"type": "string", "minLength": 1},
    "http_method": {"type": "string", "pattern": "^[A-Z]+$"},
    "canonical_path": {"type": "string", "pattern": "^/"},
    "content_type": {"type": "string"},
    "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "minLength": 1},
    "principal_epoch": {"type": "integer", "minimum": 0},
    "key_epoch": {"type": "integer", "minimum": 0},
    "resource": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1}
  }
}
