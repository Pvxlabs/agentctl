{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentctl.dev/schemas/manifest.schema.json",
  "title": "agentctl project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "audiences", "actions"],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "audiences": {
      "type": "object",
          "minProperties": 1,
            "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["base_url", "audience"],
        "properties": {
          "base_url": {"type": "string", "format": "uri"},
          "audience": {"type": "string", "minLength": 1}
        }
      }
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path", "scope"],
        "properties": {
          "method": {"type": "string", "pattern": "^[A-Za-z]+$"},
          "path": {"type": "string", "pattern": "^/"},
          "scope": {"type": "string", "minLength": 1},
          "audience": {"type": "string", "minLength": 1},
          "content_type": {"type": "string"},
          "resource": {"type": "string", "minLength": 1}
        }
      }
    },
    "trusted_access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "environment": {"type": "string", "minLength": 1},
        "transports": {
          "type": "array",
          "items": {"enum": ["localhost", "tailscale"]},
          "uniqueItems": true
        },
        "principals": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "scopes"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "subject": {"type": "string", "minLength": 1},
                "type": {"enum": ["human", "agent", "observer"]},
                "principal_type": {"enum": ["human", "agent", "observer"]},
              "scopes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "application": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity"],
          "properties": {
            "identity": {"type": "string", "minLength": 1},
            "audience": {"type": "string", "minLength": 1}
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"enum": ["declarative_mapping", "custom"]},
            "mappings": {
              "type": "object",
              "additionalProperties": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
